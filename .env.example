# 将本模板复制为 .env，再填写自己的配置；不要提交 .env。
APP_ENV=development

# Web 和 Worker 从项目根目录启动，共用这个 SQLite 文件。
DATABASE_URL=sqlite+pysqlite:///./write_agent.db

# 在本地 .env 填写密钥，并按服务商支持的模型和接口地址调整。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_MODEL=gpt-5.5
OPENAI_REVIEW_MODEL=gpt-5.5
OPENAI_REASONING_EFFORT=xhigh
OPENAI_STREAM_REASONING_EFFORT=medium
OPENAI_FALLBACK_MODEL=
OPENAI_FALLBACK_REASONING_EFFORT=
OPENAI_STORE_RESPONSE=false
OPENAI_TIMEOUT_SECONDS=120

# Embedding 地址和密钥留空时复用模型连接配置。
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_FALLBACK_MODE=keyword
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

# 默认使用模拟浏览器并禁用发布；真实发布需单独配置和验证。
FANQIE_BROWSER_MODE=stub
FANQIE_AUTHOR_URL=
FANQIE_USERNAME=
FANQIE_PASSWORD=
FANQIE_SCREENSHOT_DIR=logs
FANQIE_HEADLESS=true
FANQIE_SLOW_MO_MS=0
PUBLISH_MODE=

# 留下方单轮限制为注释时，Worker 会持续轮询。
WORKER_BATCH_LIMIT=10
WORKER_POLL_INTERVAL_SECONDS=5
# WORKER_MAX_CYCLES=1
